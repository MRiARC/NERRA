# Copy to backend/.env and adjust. Defaults work with `make up`.

# --- Database (matches docker-compose.yml; container is on host port 5433) ---
DATABASE_URL=postgresql+psycopg://nerra:nerra_dev_password@localhost:5433/nerra
# Used by pytest (conftest auto-creates this database):
TEST_DATABASE_URL=postgresql+psycopg://nerra:nerra_dev_password@localhost:5433/nerra_test

# --- Security ---
JWT_SECRET=dev-only-change-me

# --- LLMs ---
# Required from Task 03 onward: https://console.anthropic.com
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-4.5
FAST_MODEL=claude-haiku-4.5
CHAT_MODEL=claude-sonnet-4.5

# --- Embeddings (local, free, no key needed) ---
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
